Output tutorial_overview.gif
Output tutorial_overview.mp4

Set FontSize 16
Set Width 1200
Set Height 800
Set Theme "Catppuccin Macchiato"
Set WindowBar Colorful
Set Padding 30

Ctrl+L
Sleep 300ms

Type "# DevPilot — WSL2 Developer Workstation Bootstrapper"
Sleep 1s
Enter
Sleep 500ms

Ctrl+L
Sleep 300ms

Type "devpilot --help"
Sleep 500ms
Enter
Sleep 3s

Ctrl+L
Sleep 300ms

Type "devpilot --version"
Sleep 300ms
Enter
Sleep 1s

Ctrl+L
Sleep 300ms

Type "devpilot info"
Sleep 300ms
Enter
Sleep 3s

Ctrl+L
Sleep 300ms

Type "devpilot profile list"
Sleep 300ms
Enter
Sleep 3s

Ctrl+L
Sleep 300ms

Type "devpilot doctor --help"
Sleep 300ms
Enter
Sleep 3s

Ctrl+L
Sleep 300ms

Type "devpilot setup --help"
Sleep 300ms
Enter
Sleep 3s

Ctrl+L
Sleep 300ms

Type "devpilot init --help"
Sleep 300ms
Enter
Sleep 3s

Ctrl+L
Sleep 300ms

Type "# github.com/pkp09/devpilot"
Sleep 500ms
Enter
