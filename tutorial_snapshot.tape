Output tutorial_snapshot.gif
Output tutorial_snapshot.mp4

Set FontSize 16
Set Width 1200
Set Height 800
Set Theme "Catppuccin Macchiato"
Set WindowBar Colorful
Set Padding 30

Ctrl+L
Sleep 300ms

Type "# DevPilot Snapshot — Capture & Restore Environment"
Sleep 1s
Enter
Sleep 500ms

Ctrl+L
Sleep 300ms

Type "devpilot snapshot --help"
Sleep 300ms
Enter
Sleep 3s

Ctrl+L
Sleep 300ms

Type "devpilot snapshot save my-setup"
Sleep 300ms
Enter
Sleep 2s

Ctrl+L
Sleep 300ms

Type "devpilot snapshot list"
Sleep 300ms
Enter
Sleep 1s

Ctrl+L
Sleep 300ms

Type "devpilot snapshot diff my-setup"
Sleep 300ms
Enter
Sleep 2s

Ctrl+L
Sleep 300ms

Type "# Tracks packages, env vars, and config files"
Sleep 1s
Enter
Sleep 3s
