# DevPilot environment configuration
# Copy this file to .env and fill in your values
# Never commit .env to version control

# AI Provider (choose one: openai, anthropic, gemini, ollama)
DEVPILOT_AI_PROVIDER=openai

# OpenAI settings (used when DEVPILOT_AI_PROVIDER=openai)
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic settings (used when DEVPILOT_AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-haiku-4-5

# Gemini settings (used when DEVPILOT_AI_PROVIDER=gemini)
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.0-flash

# Ollama settings (used when DEVPILOT_AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
