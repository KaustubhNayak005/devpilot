Output tutorial_init.gif
Output tutorial_init.mp4

Set FontSize 16
Set Width 1200
Set Height 800
Set Theme "Catppuccin Macchiato"
Set WindowBar Colorful
Set Padding 30

Ctrl+L
Sleep 300ms

Type "# DevPilot Init — Scaffold New Projects"
Sleep 1s
Enter
Sleep 500ms

Ctrl+L
Sleep 300ms

Type "devpilot init --help"
Sleep 300ms
Enter
Sleep 3s

Ctrl+L
Sleep 300ms

Type "devpilot init python my-project"
Sleep 300ms
Enter
Sleep 1s

Ctrl+L
Sleep 300ms

Type "ls -la my-project/"
Sleep 300ms
Enter
Sleep 1s

Ctrl+L
Sleep 300ms

Type "cat my-project/pyproject.toml"
Sleep 300ms
Enter
Sleep 2s

Ctrl+L
Sleep 300ms

Type "cat my-project/src/my-project/main.py"
Sleep 300ms
Enter
Sleep 2s

Ctrl+L
Sleep 300ms

Type "rm -rf my-project"
Sleep 200ms
Enter
Sleep 500ms

Ctrl+L
Sleep 300ms

Type "devpilot init cli my-cli"
Sleep 300ms
Enter
Sleep 1s

Ctrl+L
Sleep 300ms

Type "cat my-cli/src/my-cli/main.py"
Sleep 300ms
Enter
Sleep 2s

Ctrl+L
Sleep 300ms

Type "rm -rf my-cli"
Sleep 200ms
Enter
Sleep 500ms

Ctrl+L
Sleep 300ms

Type "# Available: cpp | python | cli"
Sleep 1s
Enter
Sleep 3s
